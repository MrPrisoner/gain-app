{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // DOM is needed for the client-side modules (copy/download helpers); the
    // pure core and the server layer never touch it.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  // The generated tsconfig covers src/**; tests and the root config files stay
  // included exactly as before the app existed. svelte-check covers the .svelte
  // files (`npm run check`); tsc itself only ever sees TypeScript.
  //
  // `e2e/**` and `playwright.config.ts` are here so the browser suite is typechecked
  // by `npm run verify` even though it is never *run* by it — a spec that no longer
  // compiles is a broken test whether or not anyone launched a browser today.
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "svelte.config.js",
    "eslint.config.js"
  ]
}
