# GAIN deployment configuration — copy to `.env` beside compose.yaml and fill in.
# Never commit the real `.env` (it is git-ignored).

# Host port the reverse proxy / browser hits. The container always listens on
# 3000 internally (ARCHITECTURE §3).
GAIN_PORT=8420

# The public HTTPS URL of this instance — exactly as the browser sees it. Must
# start with https:// (the app refuses to start otherwise): the session cookie
# is always issued Secure, so an http:// origin and the cookie silently
# disagree and login fails with no diagnostic. SvelteKit uses it for CSRF
# checks and it forms the OIDC redirect URI (${ORIGIN}/auth/callback). Getting
# this wrong is the #1 cause of login loops behind a reverse proxy
# (ARCHITECTURE §14); the container logs the effective value at startup so you
# can verify it.
ORIGIN=https://gain.example.com

# Authentik OAuth2/OpenID provider for this instance. The redirect URI
# ${ORIGIN}/auth/callback must be registered on the provider, and the provider
# must map a `groups` scope/claim so the group gate can read it (ARCHITECTURE §4).
OIDC_ISSUER=https://auth.example.com/application/o/gain/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Membership of this Authentik group is required to use GAIN. A signed-in
# user without it gets a 403 with an explanation; the gate is re-checked on
# every token refresh, not just first login.
OIDC_REQUIRED_GROUP=gain-users

# Optional. Members of this Authentik group get the operator screen at /admin:
# per-user counts, and the ability to reset a user's data. Unset means this
# instance has no admin at all. Operators cannot read any user's training content.
OIDC_ADMIN_GROUP=gain-admins

# HMAC key that signs the session cookie. Generate with: openssl rand -hex 32
# (the app refuses anything shorter than 32 characters). Rotating this signs
# every user out at once — there is no previous-secret fallback, so a rotation
# is a deliberate mass sign-out, not a quiet key roll.
SESSION_SECRET=

# Timezone for the container (log timestamps).
TZ=Africa/Johannesburg

# Proxy depth for X-Forwarded-For parsing — how many proxies sit between the
# client and this container (ARCHITECTURE §3). Usually 1.
XFF_DEPTH=1

# ----------------------------------------------------------------------------
# Local development only. These belong in `.env.local` (git-ignored), not here
# and not in `.env` — they are per-developer facts, and both of them weaken a
# guard that production needs.
#
# GAIN_DEV_USER=you
#   Bypasses OIDC entirely and signs you in as that user id, so the UI can be
#   built without an Authentik to point at. Refused unless ORIGIN is a loopback
#   address (localhost, 127.0.0.1, [::1]) — an instance anyone else can reach
#   refuses to start with it set, whatever NODE_ENV says.
#
# GAIN_DEV_ADMIN=you
#   The GAIN_DEV_USER name to treat as an operator. A name, not a flag, so an
#   e2e run can drive an admin and a non-admin at the same time. Refused on a
#   non-loopback ORIGIN, like the bypass itself.
#
# GAIN_DEV_HOSTS=my-desktop.home.arpa
#   Comma-separated hostnames the Vite dev server may be reached at. Setting it
#   also binds the dev server beyond localhost, which is how you run a session
#   on a real phone. Unset, the dev server stays on localhost.
# ----------------------------------------------------------------------------