{
  // Prettier is the only formatter, for every language it handles. That matters more
  // than it looks: docs/, fixtures/ and templates/ are byte-sensitive and
  // listed in .prettierignore, and the Prettier extension honours that file — but only
  // for files it is actually the formatter for. If VS Code's built-in Markdown or JSON
  // formatter runs on save instead, .prettierignore is not consulted and a reformatted
  // CONTRACT.md silently changes the instructions every AI receives.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "prettier.requireConfig": true,

  // Use the repo's TypeScript, not the one bundled with VS Code — this repo is on a
  // newer major than most editors ship.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // A NUL or other control character in source turns the file binary as far as git is
  // concerned, and it is invisible while you type. The gain/no-control-characters
  // ESLint rule catches it on lint; this shows it immediately.
  "editor.renderControlCharacters": true,

  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "search.exclude": {
    "node_modules": true,
    "package-lock.json": true
  }
}
